# One place for every setting used by scripts/*.sh.
# Values already exported in your shell win (e.g. CLUSTER=x bash scripts/01-...).
: "${AWS_PROFILE:=abip007}"                    # your IAM user's CLI profile (never root keys)
: "${AWS_REGION:=ap-south-1}"
: "${CLUSTER:=obs-eks}"                        # EKS cluster name; also prefixes IAM policies, ECR repos, the ALB group
: "${K8S_VERSION:=1.36}"
: "${NODE_TYPE:=m7i-flex.large}"               # free-plan eligible: 2 vCPU/8 GiB, 29 pods/node
: "${NODE_MIN:=2}"
: "${NODE_DESIRED:=3}"                         # 3 nodes: the app + Prometheus, Loki, Grafana, Alloy
: "${NODE_MAX:=5}"
: "${VPC_CIDR:=10.2.0.0/16}"                   # different from eks-argocd-3tier (10.1.0.0/16)

: "${DOMAIN:=bestclick.click}"                 # Route 53 public hosted zone in this account
: "${APP_HOST:=obs-bmi.$DOMAIN}"               # public URL of the app
: "${ARGOCD_HOST:=obs-argocd.$DOMAIN}"         # public URL of the Argo CD UI
: "${GRAFANA_HOST:=obs-grafana.$DOMAIN}"       # public URL of Grafana
: "${CERT_ARN:=}"                              # empty = find/request the ACM cert for DOMAIN + *.DOMAIN
: "${ZONE_ID:=}"                               # empty = the public hosted zone the registrar delegates to

: "${GIT_REPO_URL:=https://github.com/abip007/eks-argocd-observability.git}"   # the repo Argo CD watches
: "${GIT_BRANCH:=main}"

export AWS_PROFILE AWS_REGION
